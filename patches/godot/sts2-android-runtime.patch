+static void *ios_open_dotnet_native_lib(const char *stem) {
+	char path_buf[512];
+	snprintf(path_buf, sizeof(path_buf), "@rpath/%s.framework/%s", stem, stem);
+	void *handle = dlopen(path_buf, RTLD_LAZY | RTLD_GLOBAL);
+	if (handle) {
+		return handle;
+	}
+	snprintf(path_buf, sizeof(path_buf), "@executable_path/Frameworks/%s.framework/%s", stem, stem);
+	handle = dlopen(path_buf, RTLD_LAZY | RTLD_GLOBAL);
+	if (handle) {
+		return handle;
+	}
+	snprintf(path_buf, sizeof(path_buf), "@executable_path/%s.dylib", stem);
+	handle = dlopen(path_buf, RTLD_LAZY | RTLD_GLOBAL);
+	return handle;
+}
+
+static void *ios_pinvoke_override(const char *library_name, const char *entrypoint_name) {
+	if (library_name == nullptr || entrypoint_name == nullptr) {
+		return nullptr;
+	}
+
+	auto try_dlsym = [](void *handle, const char *symbol_name) -> void * {
+		if (!handle || !symbol_name) {
+			return nullptr;
+		}
+		void *sym = dlsym(handle, symbol_name);
+		if (!sym && symbol_name[0] != '_') {
+			char prefixed[256];
+			snprintf(prefixed, sizeof(prefixed), "_%s", symbol_name);
+			sym = dlsym(handle, prefixed);
+		}
+		return sym;
+	};
+
+	if (strcmp(library_name, "__Internal") == 0) {
+		return try_dlsym(RTLD_DEFAULT, entrypoint_name);
+	}
+
+	if (strstr(library_name, "System.Native") != nullptr) {
+		static void *s_sys_native = ios_open_dotnet_native_lib("libSystem.Native");
+		if (void *sym = try_dlsym(s_sys_native, entrypoint_name)) {
+			return sym;
+		}
+	} else if (strstr(library_name, "System.Globalization.Native") != nullptr) {
+		static void *s_glob_native = ios_open_dotnet_native_lib("libSystem.Globalization.Native");
+		if (void *sym = try_dlsym(s_glob_native, entrypoint_name)) {
+			return sym;
+		}
+	} else if (strstr(library_name, "System.IO.Compression.Native") != nullptr) {
+		static void *s_comp_native = ios_open_dotnet_native_lib("libSystem.IO.Compression.Native");
+		if (void *sym = try_dlsym(s_comp_native, entrypoint_name)) {
+			return sym;
+		}
+	} else if (strstr(library_name, "System.Security.Cryptography.Native.Apple") != nullptr) {
+		static void *s_crypto_native = ios_open_dotnet_native_lib("libSystem.Security.Cryptography.Native.Apple");
+		if (void *sym = try_dlsym(s_crypto_native, entrypoint_name)) {
+			return sym;
+		}
+	}
+
+	return try_dlsym(RTLD_DEFAULT, entrypoint_name);
+}
