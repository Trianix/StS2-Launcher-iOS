+static bool ios_invoke_godot_plugin_init(const char *assembly_name, const char *type_name, const char *method_name, void *godot_dll_handle, void *managed_callbacks, const void **interop_funcs, int32_t interop_funcs_size) {
+	void *domain = mono_native::mono_get_root_domain();
+	if (!domain) {
+		print_line(".NET: iOS mono_get_root_domain returned null");
+		return false;
+	}
+	MonoAssemblyName *aname = mono_native::mono_assembly_name_new(assembly_name);
+	MonoAssembly *assembly = mono_native::mono_assembly_loaded(aname);
+	if (!assembly) {
+		assembly = mono_native::mono_assembly_load_full(aname, nullptr, nullptr, false);
+	}
+	mono_native::mono_assembly_name_free(aname);
+	if (!assembly) {
+		print_line(String(".NET: iOS assembly '") + assembly_name + "' not loaded");
+		return false;
+	}
+	MonoImage *image = mono_native::mono_assembly_get_image(assembly);
+	const char *last_dot = strrchr(type_name, '.');
+	MonoClass *klass = nullptr;
+	if (last_dot) {
+		char ns[256];
+		size_t ns_len = last_dot - type_name;
+		if (ns_len < sizeof(ns)) {
+			strncpy(ns, type_name, ns_len);
+			ns[ns_len] = '\0';
+			klass = mono_native::mono_class_from_name(image, ns, last_dot + 1);
+		}
+	} else {
+		klass = mono_native::mono_class_from_name(image, "", type_name);
+	}
+	if (!klass) {
+		print_line(String(".NET: iOS class '") + type_name + "' not found");
+		return false;
+	}
+	MonoMethod *method = mono_native::mono_class_get_method_from_name(klass, method_name, 4);
+	if (!method) {
+		print_line(String(".NET: iOS method '") + method_name + "' not found");
+		return false;
+	}
+	void *arg0 = godot_dll_handle;
+	void *arg1 = managed_callbacks;
+	void *arg2 = (void *)interop_funcs;
+	int32_t arg3 = interop_funcs_size;
+	void *args[4] = { &arg0, &arg1, &arg2, &arg3 };
+	MonoObject *exc = nullptr;
+	MonoObject *res = mono_native::mono_runtime_invoke(method, nullptr, args, &exc);
+	if (exc) {
+		print_line(String(".NET: iOS '") + method_name + "' threw an unhandled exception:");
+		mono_native::mono_print_unhandled_exception(exc);
+		return false;
+	}
+	int ret_val = 1;
+	if (res) {
+		ret_val = *(int *)mono_native::mono_object_unbox(res);
+	}
+	print_line(String(".NET: iOS '") + method_name + "' invoked via mono_runtime_invoke, returned " + itos(ret_val));
+	return (ret_val != 0);
+}
