+static void ios_invoke_sts2mobile_apply() {
+	void *domain = mono_native::mono_get_root_domain();
+	if (!domain) return;
+	MonoAssemblyName *aname = mono_native::mono_assembly_name_new("STS2Mobile");
+	MonoAssembly *assembly = mono_native::mono_assembly_loaded(aname);
+	if (!assembly) {
+		assembly = mono_native::mono_assembly_load_full(aname, nullptr, nullptr, false);
+	}
+	mono_native::mono_assembly_name_free(aname);
+	if (!assembly) return;
+	MonoImage *image = mono_native::mono_assembly_get_image(assembly);
+	MonoClass *klass = mono_native::mono_class_from_name(image, "STS2Mobile", "ModEntry");
+	if (!klass) return;
+	MonoMethod *method = mono_native::mono_class_get_method_from_name(klass, "Apply", 0);
+	if (!method) return;
+	MonoObject *exc = nullptr;
+	mono_native::mono_runtime_invoke(method, nullptr, nullptr, &exc);
+	if (exc) {
+		print_line(".NET: iOS ModEntry.Apply threw an unhandled exception:");
+		mono_native::mono_print_unhandled_exception(exc);
+	} else {
+		print_line(".NET: iOS ModEntry.Apply completed successfully via mono_runtime_invoke");
+	}
+}
